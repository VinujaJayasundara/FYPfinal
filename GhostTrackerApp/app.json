{
  "expo": {
    "name": "GhostTrackerApp",
    "slug": "GhostTrackerApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0E10"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ghost-Tracker needs your location to track your run route in real-time.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Ghost-Tracker needs your location to track your run route in the background."
      }
    },
    "android": {
      "package": "com.equistride.ghosttracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0E10"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ghost-Tracker needs your location to track runs.",
          "isAndroidForegroundServiceEnabled": true,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ghost-Tracker uses your photos to set a profile picture. The picture stays on this phone.",
          "cameraPermission": "Ghost-Tracker uses the camera to take a profile picture. The picture stays on this phone.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#BF5AF2"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-font",
      "expo-sharing"
    ]
  }
}
